# Copy to .env and edit. Every value is optional.
DATA_SOURCE=yfinance          # yfinance (real data) | synthetic (offline demo data)
DEFAULT_SYMBOL=BTC-USD        # BTC-USD trades 24/7; try SPY, RELIANCE.NS, ETH-USD
POLL_SECONDS=30
LOG_LEVEL=INFO
